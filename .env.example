# ════════════════════════════════════════════════════════════════════════════
# Siebel SSJ New Customer – Automation Configuration
# Copy this file to .env and fill in all values before running.
# ════════════════════════════════════════════════════════════════════════════

# ── Siebel Application ───────────────────────────────────────────────────────
BASE_URL=https://ek4vlws0377.appc.tpgtelecom.com.au:9001/siebel/app/care/enu?SWECmd=GotoView&SWEView=VHA+SSJ+New+Customer+View&SWERF=1&SWEHo=&SWEBU=1&SWEApplet0=VHA+SSJ+Account+Entry+Applet&SWERowId0=VRId-0
SIEBEL_USERNAME=CAREUSER1
SIEBEL_PASSWORD=CAREUSER1

# ── Browser ──────────────────────────────────────────────────────────────────
PLAYWRIGHT_CHANNEL=msedge
HEADLESS=true
STEP_TIMEOUT_MS=30000
TEST_TIMEOUT_MS=300000

# ── Proxy (optional) ─────────────────────────────────────────────────────────
# Set BROWSER_PROXY_SERVER if your machine uses a corporate/RDP internet proxy.
# The Siebel server is always bypassed automatically.
# Example: BROWSER_PROXY_SERVER=http://internet-proxy.dc.example.com:8080
# Leave blank to use the Windows system proxy (also auto-bypassed for Siebel).
BROWSER_PROXY_SERVER=
#
# Add extra hosts to bypass in addition to the default Siebel bypass list.
# Comma or semicolon separated. Leave blank if not needed.
NO_PROXY=

# ── Step 2: Customer Name ────────────────────────────────────────────────────
FIRST_NAME=John
LAST_NAME=Smith

# ── Step 3: Coverage Check Address ──────────────────────────────────────────
ADDRESS=468 FRIEND Boulevard, BURWOOD NSW 3125

# ── Step 4: PLP ──────────────────────────────────────────────────────────────
PLAN_TAB=Fixed

# ── Step 6: Customer Details ──────────────────────────────────────────────────
DOB=01/01/1990
CONTACT_NO=0400000001
EMAIL=test.user@vodafone.com.au
CA_PIN=1234

# ── Step 7: ID Details ───────────────────────────────────────────────────────
ID_TYPE=Passport
PASSPORT_NUMBER=A1111111
PASSPORT_EXPIRY=01/01/2030

# ── Step 8: Credit Check ──────────────────────────────────────────────────────
EMPLOYMENT_STATUS=Full Time
OCCUPATION=Professional
EMPLOYER_NAME=Test Corp
EMPLOYER_ADDRESS=1 Test Street, Sydney NSW 2000

# ── Step 10: Billing ──────────────────────────────────────────────────────────
ACCOUNT_NUMBER=123456789
ACCOUNT_NAME=John Smith
BSB_NUMBER=012605

# ── Step 11: Coverage (AVC) ──────────────────────────────────────────────────
AVC_ID_OPTION=Unknown AVC ID

# ── Step 12: Transfer ────────────────────────────────────────────────────────
TRANSFER_TYPE=New

# ── Step 13: Proposition ─────────────────────────────────────────────────────
MSISDN=
IMEI_NUMBER=

# ── Step 15: Order Review ─────────────────────────────────────────────────────
STORE_ADDRESS=

# ── Figma Comparison ─────────────────────────────────────────────────────────
FIGMA_MAX_DIFF_PERCENT=5
PDF_SCALE=2
FIGMA_SSJ_PDF=./input/SSJ.pdf
FIGMA_SFJ_PDF=./input/SFJ.pdf

# ── Excel Agent ──────────────────────────────────────────────────────────────
INPUT_XLSX=./input/SSJ FULLFILLMENT_TESTCASES.xlsx
FIGMA_DIR=./input/figma
FALLBACK_FIGMA_IMAGE=./input/image.png
OUTPUT_DIR=./output
MAX_CASES=0
KEEP_EXECUTION_HISTORY=false
